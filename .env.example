# Local development: SQLite with demo data and tokens from dev/mint_token.py.
# cp .env.example .env
LUCENT_DATABASE_URL=sqlite:///dev/lucent.db
LUCENT_OIDC_ISSUER=https://dev.lucent.invalid
LUCENT_OIDC_AUDIENCE=lucentapi
LUCENT_OIDC_JWKS_FILE=dev/jwks.json
LUCENT_NUMBERING_OFFSET=3000

# Against MariaDB and an identity provider, for example Keycloak:
# LUCENT_DATABASE_URL=mysql+pymysql://lucentapi:PASSWORD@db.example.org/lucent?charset=utf8mb4
# LUCENT_OIDC_ISSUER=https://id.example.org/realms/lucent
# LUCENT_OIDC_AUDIENCE=lucentapi
# LUCENT_ROLES_CLAIM=realm_access.roles
